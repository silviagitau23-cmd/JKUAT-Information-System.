
#include <iostream>
#include <string>
#include <vector>
using namespace std;

// ==================== STUDENT CLASS ====================
class Student {
private:
    string name;
    string registrationNumber;
    vector<string> registeredUnits;
    vector<double> marks;

public:
    Student(string n, string reg) {
        name = n;
        registrationNumber = reg;
    }

    string getName() {
        return name;
    }

    string getRegistrationNumber() {
        return registrationNumber;
    }

    void registerUnit(string unit) {
        registeredUnits.push_back(unit);
        marks.push_back(-1);
        cout << "Unit registered successfully.\n";
    }

    void viewUnits() {
        cout << "\n--- REGISTERED UNITS ---\n";

        if (registeredUnits.empty()) {
            cout << "No units registered.\n";
            return;
        }

        for (int i = 0; i < registeredUnits.size(); i++) {
            cout << i + 1 << ". " << registeredUnits[i];

            if (marks[i] == -1)
                cout << " | Mark: Not yet entered";
            else
                cout << " | Mark: " << marks[i];

            cout << endl;
        }
    }

    void addMark(int unitNumber, double mark) {
        if (unitNumber >= 0 && unitNumber < marks.size()) {
            marks[unitNumber] = mark;
        }
    }

    void viewScores() {
        cout << "\n--- STUDENT SCORES ---\n";

        if (registeredUnits.empty()) {
            cout << "No units registered.\n";
            return;
        }

        for (int i = 0; i < registeredUnits.size(); i++) {
            cout << registeredUnits[i] << " : ";

            if (marks[i] == -1)
                cout << "No mark available";
            else
                cout << marks[i];

            cout << endl;
        }
    }
};

