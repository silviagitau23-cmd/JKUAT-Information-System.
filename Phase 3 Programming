// ==================== STUDENT MENU ====================
void studentMenu(Student &student) {

    int choice;

    do {
        cout << "\n================================\n";
        cout << "       STUDENT MODULE\n";
        cout << "================================\n";
        cout << "1. Register Unit\n";
        cout << "2. View Registered Units\n";
        cout << "3. View Scores\n";
        cout << "4. View LMS Information\n";
        cout << "5. Logout\n";
        cout << "Enter choice: ";
        cin >> choice;

        switch (choice) {

        case 1: {
            string unit;
            cout << "Enter unit name/code: ";
            cin.ignore();
            getline(cin, unit);

            student.registerUnit(unit);
            break;
        }

        case 2:
            student.viewUnits();
            break;

        case 3:
            student.viewScores();
            break;

        case 4:
            cout << "\n--- LMS INFORMATION ---\n";
            cout << "Access your notes, assignments, CATs and examinations through the LMS.\n";
            break;

        case 5:
            cout << "Logging out...\n";
            break;

        default:
            cout << "Invalid choice.\n";
        }

    } while (choice != 5);
}

// ==================== LECTURER MENU ====================
void lecturerMenu(Lecturer &lecturer, Student &student) {

    int choice;

    do {
        cout << "\n================================\n";
        cout << "       LECTURER MODULE\n";
        cout << "================================\n";
        cout << "1. Manage Notes\n";
        cout << "2. Manage Assignments\n";
        cout << "3. Manage CATs\n";
        cout << "4. Manage Examinations\n";
        cout << "5. Enter Student Mark\n";
        cout << "6. View Student Information\n";
        cout << "7. Logout\n";
        cout << "Enter choice: ";
        cin >> choice;

        switch (choice) {

        case 1:
            lecturer.manageNotes();
            break;

        case 2:
            lecturer.manageAssignment();
            break;

        case 3:
            lecturer.manageCAT();
            break;

        case 4:
            lecturer.manageExam();
            break;

        case 5: {
            int unitNumber;
            double mark;

            student.viewUnits();

            cout << "\nEnter unit number to enter mark for: ";
            cin >> unitNumber;

            cout << "Enter mark: ";
            cin >> mark;

            student.addMark(unitNumber - 1, mark);

            cout << "Mark entered successfully.\n";
            cout << "The mark is now available for the student to view.\n";

            break;
        }

        case 6:
            cout << "\n--- STUDENT INFORMATION ---\n";
            cout << "Student Name: " << student.getName() << endl;
            cout << "Registration Number: "
                 << student.getRegistrationNumber() << endl;

            student.viewUnits();
            break;

        case 7:
            cout << "Logging out...\n";
            break;

        default:
            cout << "Invalid choice.\n";
        }

    } while (choice != 7);
}

